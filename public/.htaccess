# =========================================================================
# ניתוב צד-לקוח (SPA) עבור האדמין המוגש מתת-התיקייה /sweet-admin/
#
# בלי זה, רענון או כניסה ישירה לכתובת כמו /sweet-admin/products יחזירו 404,
# כי אין קובץ כזה על הדיסק — הנתיב מטופל על ידי React Router בדפדפן.
#
# רלוונטי ל-Apache בלבד. אם srv2 מריץ nginx — יש להשתמש במקום זה ב:
#   location /sweet-admin/ { try_files $uri $uri/ /sweet-admin/index.html; }
# =========================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sweet-admin/

  # קבצים ותיקיות שקיימים בפועל — להגיש כרגיל (JS, CSS, תמונות)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # כל השאר — להחזיר ל-index.html כדי שהראוטר יטפל בנתיב
  RewriteRule ^ index.html [L]
</IfModule>

# ה-service worker וה-index לא אמורים להיות במטמון, אחרת גולשים יישארו
# תקועים על גרסה ישנה אחרי כל עדכון.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # נכסים עם hash בשם הקובץ — אפשר לשמור במטמון לאורך זמן
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
