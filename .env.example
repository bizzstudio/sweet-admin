# =========================================================================
# תבנית להגדרות האדמין.
#
# על השרת:   cp .env.example .env    ואז לערוך את הערכים.
# הקובץ .env עצמו לא נכנס ל-git (ראה .gitignore) — כל שרת מחזיק משלו.
#
# ⚠ כל משתנה שמתחיל ב-VITE_ נצרב לתוך קבצי ה-JS ונראה לכל גולש בדפדפן.
#   אין להכניס לכאן סודות — רק כתובות ציבוריות.
#   סודות (מפתחות API, סיסמאות) שייכים ל-.env של הבקאנד בלבד.
#
# ⚠ שינוי בקובץ הזה מחייב build מחדש (npm run build). הערכים נקראים
#   בזמן הבנייה, לא בזמן ריצה.
# =========================================================================

# ---- תת-התיקייה שממנה האדמין מוגש ----
# "/"              = דומיין ייעודי, למשל admin.example.com
# "/sweet-admin/"  = תת-תיקייה, למשל srv2.bizzstudio.co.il/sweet-admin/
VITE_APP_BASE_PATH=/

# ---- כתובת האדמין עצמו (משמש להפניה אחרי התנתקות) ----
VITE_APP_ADMIN_DOMAIN=https://admin.example.com

# ---- כתובת החנות (הקישור "צפייה בחנות") ----
VITE_APP_STORE_DOMAIN=https://example.com

# ---- ה-API של הבקאנד. חייב להסתיים ב-/api ----
VITE_APP_API_BASE_URL=https://example.com/api

# ---- socket.io ----
# כרגע לא בשימוש: אין שרת socket.io מאותחל בבקאנד.
VITE_APP_API_SOCKET_URL=https://example.com

# ---- שרת הוואטסאפ (עמוד "WhatsApp Bot", מוסתר מהתפריט כרגע) ----
VITE_APP_WHATSAPP_SOCKET_URL=

# ---- Cloudinary ----
# לא בשימוש בקוד — ההעלאות עוברות ל-POST /api/upload בבקאנד.
# אין להוסיף כאן API_SECRET: הוא ייחשף לכל גולש. חתימה מתבצעת בשרת בלבד.
VITE_APP_CLOUD_NAME=
VITE_APP_CLOUDINARY_UPLOAD_PRESET=
VITE_APP_CLOUDINARY_URL=
