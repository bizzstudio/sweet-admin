# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist

# ---- קבצי סביבה ----
# חוסמים כל וריאציה (.env.local, .env.backup-... וכו') כדי שגיבוי או קובץ
# זמני עם סודות לא ייכנס ל-git בטעות. רק התבנית .env.example נכנסת.
.env
.env.*
!.env.example

# ---- קבצי נתונים מקומיים ----
# גיליונות עבודה בשורש הפרויקט (רשימות לקוחות/מוצרים) מכילים נתונים
# אמיתיים ואישיים — אין להעלות אותם ל-git.
/*.xlsx
/*.xls
/*.csv

# misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# css
/src/assets/css/tailwind.output.css
